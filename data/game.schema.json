{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Game",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "order", "timezone", "resetHour", "weekStartsOn", "source", "tasks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "order": { "type": "integer" },
    "timezone": { "type": "string", "minLength": 1, "description": "IANA 시간대, 예: Asia/Seoul" },
    "resetHour": { "type": "integer", "minimum": 0, "maximum": 23 },
    "weekStartsOn": { "type": "integer", "minimum": 0, "maximum": 6, "description": "0=일 … 6=토" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "checkedAt"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "cycle"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["check", "count"] },
          "target": { "type": "integer", "minimum": 1, "description": "count형의 목표 횟수(check형은 생략)" },
          "endsAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "기간 한정 이벤트 종료일(포함)" },
          "cycle": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["type"],
                "properties": { "type": { "enum": ["daily", "weekly", "monthly"] } } },
              { "type": "object", "additionalProperties": false, "required": ["type", "days", "anchor"],
                "properties": {
                  "type": { "const": "everyNDays" },
                  "days": { "type": "integer", "minimum": 1 },
                  "anchor": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "첫 주기가 시작되는 게임 날짜" }
                } }
            ]
          }
        },
        "allOf": [
          { "if": { "properties": { "kind": { "const": "count" } } }, "then": { "required": ["target"] } }
        ]
      }
    }
  }
}
